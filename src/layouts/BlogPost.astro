---
import Layout from './Layout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  headings?: Heading[];
}

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface TocEntry extends Heading {
  id: string;
  parentId: string;
  level: number;
  hasChildren: boolean;
}

function buildTocEntries(headings: Heading[]) {
  const entries: TocEntry[] = [];
  const stack: TocEntry[] = [];

  headings
    .filter((heading) => (
      heading.depth >= 1 &&
      heading.depth <= 6 &&
      heading.slug.trim() !== '' &&
      heading.text.trim() !== ''
    ))
    .forEach((heading, index) => {
      while (stack.length > 0 && heading.depth <= stack[stack.length - 1].depth) {
        stack.pop();
      }

      const parent = stack.at(-1);
      const entry: TocEntry = {
        depth: heading.depth,
        slug: heading.slug,
        text: heading.text.trim(),
        id: `toc-heading-${index}`,
        parentId: parent?.id ?? '',
        level: stack.length,
        hasChildren: false,
      };

      if (parent) parent.hasChildren = true;
      entries.push(entry);
      stack.push(entry);
    });

  return entries;
}

const { post, headings = [] } = Astro.props;
const { title, description, pubDate, updatedDate, tags, author } = post.data;
const formattedDate = pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const formattedUpdatedDate = updatedDate?.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const tocEntries = buildTocEntries(headings);
---

<Layout title={title} description={description}>
  <article class="post-page-shell mx-auto px-5 py-10 md:py-12">
    <header class="article-header article-main-column mb-9 border-b border-stone-200 pb-6 dark:border-stone-800">
      <h1 class="mb-3 font-serif text-2xl font-bold leading-tight tracking-normal text-stone-950 dark:text-stone-50 md:text-[1.7rem]">
        {title}
      </h1>
      <p class="border-l-4 border-stone-200 pl-4 text-base leading-7 text-stone-600 dark:border-stone-700 dark:text-stone-300">
        {description}
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-4 text-sm text-stone-500 dark:text-stone-400">
        <span class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          {author}
        </span>
        <span class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          {formattedDate}
        </span>
        {updatedDate && (
          <span class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            更新于: {formattedUpdatedDate}
          </span>
        )}
      </div>
      {tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="rounded-full border border-stone-200 px-3 py-1 text-sm text-stone-600 dark:border-stone-700 dark:text-stone-300">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <div class="post-reading-grid">
      {tocEntries.length > 0 && (
        <aside class="post-toc-panel" aria-labelledby="post-toc-heading" data-post-toc>
          <h2 id="post-toc-heading" class="post-toc-title">内容导航</h2>
          <ol class="post-toc-list">
            {tocEntries.map((entry) => (
              <li
                class="post-toc-item"
                data-toc-item
                data-toc-id={entry.id}
                data-toc-parent={entry.parentId}
                data-toc-has-children={entry.hasChildren ? 'true' : 'false'}
                data-toc-expanded="false"
                data-toc-level={entry.level}
                style={`--toc-level: ${entry.level};`}
                hidden={entry.parentId !== ''}
              >
                <div class="post-toc-row">
                  <a
                    href={`#${entry.slug}`}
                    class="post-toc-link"
                    data-toc-link
                    data-toc-depth={entry.depth}
                  >
                    <span class="post-toc-link-text">{entry.text}</span>
                  </a>
                  {entry.hasChildren && (
                    <button
                      class="post-toc-toggle"
                      type="button"
                      aria-label={`展开 ${entry.text} 的小节`}
                      aria-expanded="false"
                      data-toc-toggle
                    >
                      <svg aria-hidden="true" viewBox="0 0 20 20" fill="none">
                        <path d="M7.5 4.5 13 10l-5.5 5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </button>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </aside>
      )}

      <div class="article-main-column post-content-column">
        <p
          id="post-search-status"
          class="hidden mb-6 text-sm text-gray-500 dark:text-gray-400"
          aria-live="polite"
        >
        </p>

        <div data-post-content class="prose">
          <slot />
        </div>

        <footer class="mt-16 border-t border-stone-200 pt-8 dark:border-stone-800">
          <a
            href="/blog/"
            class="inline-flex items-center gap-2 text-stone-600 transition-colors hover:text-stone-950 dark:text-stone-400 dark:hover:text-stone-50"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            返回博客列表
          </a>
        </footer>
      </div>
    </div>
  </article>
</Layout>

<script>
  const postToc = document.querySelector<HTMLElement>('[data-post-toc]');
  const postSearchForm = document.querySelector<HTMLFormElement>('[data-search-mode="post"]');
  const postSearchInput = document.querySelector<HTMLInputElement>('[data-search-mode="post"] [data-blog-search-input]');
  const postContent = document.querySelector<HTMLElement>('[data-post-content]');
  const postSearchStatus = document.getElementById('post-search-status');
  const originalPostHtml = postContent?.innerHTML ?? '';

  if (postToc) {
    const tocItems = Array.from(postToc.querySelectorAll<HTMLElement>('[data-toc-item]'));
    const itemById = new Map(tocItems.map((item) => [item.dataset.tocId ?? '', item]));
    const childrenByParent = new Map<string, HTMLElement[]>();

    tocItems.forEach((item) => {
      const parentId = item.dataset.tocParent ?? '';
      const children = childrenByParent.get(parentId) ?? [];
      children.push(item);
      childrenByParent.set(parentId, children);
    });

    function getTocChildren(item: HTMLElement) {
      return childrenByParent.get(item.dataset.tocId ?? '') ?? [];
    }

    function setTocExpanded(item: HTMLElement, expanded: boolean) {
      item.dataset.tocExpanded = expanded ? 'true' : 'false';
      const toggle = item.querySelector<HTMLButtonElement>('[data-toc-toggle]');
      const title = item.querySelector<HTMLElement>('[data-toc-link]')?.textContent?.trim() || '小节';

      if (toggle) {
        toggle.setAttribute('aria-expanded', String(expanded));
        toggle.setAttribute('aria-label', `${expanded ? '折叠' : '展开'} ${title} 的小节`);
      }
    }

    function hideTocBranch(item: HTMLElement) {
      setTocExpanded(item, false);
      getTocChildren(item).forEach((child) => {
        child.hidden = true;
        hideTocBranch(child);
      });
    }

    function revealTocPath(item: HTMLElement) {
      const path: HTMLElement[] = [];
      let current: HTMLElement | undefined = item;

      while (current) {
        path.unshift(current);
        const parentId = current.dataset.tocParent;
        current = parentId ? itemById.get(parentId) : undefined;
      }

      path.forEach((pathItem) => {
        const parentId = pathItem.dataset.tocParent ?? '';
        const siblings = childrenByParent.get(parentId) ?? [];

        siblings.forEach((sibling) => {
          if (sibling !== pathItem) hideTocBranch(sibling);
        });

        if (pathItem.dataset.tocHasChildren === 'true') {
          setTocExpanded(pathItem, true);
          getTocChildren(pathItem).forEach((child) => {
            child.hidden = false;
          });
        }
      });
    }

    postToc.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const trigger = target.closest<HTMLElement>('[data-toc-link], [data-toc-toggle]');
      const item = trigger?.closest<HTMLElement>('[data-toc-item]');
      if (!trigger || !item) return;

      if (trigger.matches('[data-toc-toggle]') && item.dataset.tocExpanded === 'true') {
        hideTocBranch(item);
        return;
      }

      revealTocPath(item);
    });
  }

  function escapeRegExp(value: string) {
    return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  function clearPostSearch() {
    if (postContent) postContent.innerHTML = originalPostHtml;
    postSearchStatus?.classList.add('hidden');
    if (postSearchStatus) postSearchStatus.textContent = '';
  }

  function highlightPostMatches(query: string) {
    if (!postContent) return 0;

    postContent.innerHTML = originalPostHtml;
    const normalizedQuery = query.trim();
    if (normalizedQuery === '') {
      clearPostSearch();
      return 0;
    }

    const matcher = new RegExp(escapeRegExp(normalizedQuery), 'gi');
    const walker = document.createTreeWalker(postContent, NodeFilter.SHOW_TEXT, {
      acceptNode(node) {
        const parent = node.parentElement;
        if (!node.nodeValue?.trim() || !parent) return NodeFilter.FILTER_REJECT;
        if (['SCRIPT', 'STYLE', 'MARK'].includes(parent.tagName)) return NodeFilter.FILTER_REJECT;
        matcher.lastIndex = 0;
        return matcher.test(node.nodeValue) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
      },
    });

    const nodes: Text[] = [];
    while (walker.nextNode()) nodes.push(walker.currentNode as Text);

    let count = 0;
    nodes.forEach((node) => {
      const text = node.nodeValue ?? '';
      const fragment = document.createDocumentFragment();
      let lastIndex = 0;
      matcher.lastIndex = 0;

      text.replace(matcher, (match, offset) => {
        fragment.append(document.createTextNode(text.slice(lastIndex, offset)));
        const mark = document.createElement('mark');
        mark.className = 'rounded bg-yellow-200 px-1 text-gray-900 dark:bg-yellow-300';
        mark.textContent = match;
        fragment.append(mark);
        lastIndex = offset + match.length;
        count += 1;
        return match;
      });

      fragment.append(document.createTextNode(text.slice(lastIndex)));
      node.parentNode?.replaceChild(fragment, node);
    });

    if (postSearchStatus) {
      postSearchStatus.classList.remove('hidden');
      postSearchStatus.textContent = `搜索 “${normalizedQuery}”，找到 ${count} 处匹配`;
    }

    postContent.querySelector('mark')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    return count;
  }

  postSearchForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    highlightPostMatches(postSearchInput?.value ?? '');
  });

  postSearchInput?.addEventListener('input', () => {
    highlightPostMatches(postSearchInput.value);
  });
</script>

<script is:inline>
  (() => {
    const mermaidBlocks = Array.from(document.querySelectorAll('pre[data-language="mermaid"] > code'));
    if (mermaidBlocks.length === 0) return;

    function prepareMermaidBlocks() {
      return mermaidBlocks.map((codeBlock) => {
        const pre = codeBlock.parentElement;
        const mermaidContainer = document.createElement('div');
        mermaidContainer.className = 'mermaid';
        mermaidContainer.textContent = codeBlock.textContent || '';
        pre?.replaceWith(mermaidContainer);
        return mermaidContainer;
      });
    }

    function resizeMermaidDiagrams() {
      document.querySelectorAll('.mermaid').forEach((diagram) => {
        const nodeCount = diagram.querySelectorAll('g.node').length;
        const edgeCount = diagram.querySelectorAll('path.flowchart-link').length;
        const svg = diagram.querySelector('svg');
        if (!svg || nodeCount === 0) return;

        const viewBox = svg.viewBox?.baseVal;
        const renderedBox = svg.getBoundingClientRect();
        const diagramWidth = viewBox?.width || renderedBox.width;
        const diagramHeight = viewBox?.height || renderedBox.height || 1;
        const aspectRatio = diagramWidth / diagramHeight;
        const isTall = nodeCount >= 3 && aspectRatio <= 1.45;
        const isWide = nodeCount >= 5 && aspectRatio >= 2.15;
        const isBranchy = nodeCount >= 5 && (edgeCount > nodeCount || aspectRatio >= 3);
        const isDense = nodeCount >= 7;

        diagram.classList.toggle('mermaid-tiny', nodeCount <= 3);
        diagram.classList.toggle('mermaid-compact', nodeCount > 3 && nodeCount <= 4);
        diagram.classList.toggle('mermaid-tall', isTall);
        diagram.classList.toggle('mermaid-wide', isWide);
        diagram.classList.toggle('mermaid-branchy', isBranchy);
        diagram.classList.toggle('mermaid-dense', isDense);
      });
    }

    async function renderMermaid() {
      if (!window.mermaid) return;

      prepareMermaidBlocks();
      window.mermaid.initialize({
        startOnLoad: false,
        theme: 'base',
        securityLevel: 'strict',
        flowchart: {
          curve: 'basis',
          htmlLabels: true,
          nodeSpacing: 46,
          rankSpacing: 58,
          padding: 16,
        },
        themeVariables: {
          background: 'transparent',
          mainBkg: '#fffaf2',
          secondBkg: '#fffaf2',
          tertiaryColor: '#fffaf2',
          primaryColor: '#fffaf2',
          primaryTextColor: '#2f2a25',
          primaryBorderColor: '#aaa7a0',
          secondaryColor: '#fffaf2',
          secondaryTextColor: '#2f2a25',
          secondaryBorderColor: '#aaa7a0',
          tertiaryTextColor: '#2f2a25',
          tertiaryBorderColor: '#aaa7a0',
          lineColor: '#aaa7a0',
          textColor: '#241f1a',
          clusterBkg: 'transparent',
          clusterBorder: '#eee7dd',
          edgeLabelBackground: '#fffaf2',
          nodeBorder: '#aaa7a0',
          fontFamily: 'ui-serif, Georgia, Cambria, "Times New Roman", Times, serif',
        },
      });
      await window.mermaid.run({ querySelector: '.mermaid' });
      resizeMermaidDiagrams();
    }

    if (window.mermaid) {
      renderMermaid();
      return;
    }

    const script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js';
    script.async = true;
    script.onload = renderMermaid;
    document.head.appendChild(script);
  })();
</script>
