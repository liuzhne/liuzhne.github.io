---
import Layout from '../layouts/Layout.astro';

const experiences = [
  {
    period: '2023 - 至今',
    title: '高级前端工程师',
    company: '某科技公司',
    description: '负责公司核心产品的前端架构设计与开发，带领团队完成多个大型项目。'
  },
  {
    period: '2020 - 2023',
    title: '全栈开发工程师',
    company: '某互联网公司',
    description: '参与前后端开发，使用 Java、Redis、Go 等技术栈构建 Web 应用。'
  },
  {
    period: '2018 - 2020',
    title: '初级开发工程师',
    company: '某创业公司',
    description: '参与产品原型开发，学习并掌握现代 Web 开发技术。'
  }
];

const skills = [
  { name: '前端开发', items: ['Vue.js', 'JavaScript'] },
  { name: '后端开发', items: ['Java', 'Redis', 'Go', 'PostgreSQL', 'MongoDB'] },
  { name: 'DevOps', items: ['Docker', 'Kubernetes', 'CI/CD', 'Linux'] },
  { name: '工具', items: ['Git', 'GitHub', 'VS Code', 'Postman'] }
];
---

<Layout title="关于我 - liuzhne" description="了解更多关于我的信息">
  <div>
    <section class="border-b border-stone-200 dark:border-stone-800">
      <div class="site-shell py-12 md:py-16">
        <p class="mb-3 text-sm font-medium text-stone-500 dark:text-stone-400">
          关于我
        </p>
        <h1 class="font-serif text-3xl font-bold leading-tight text-stone-950 dark:text-stone-50">
          liuzhne
        </h1>
        <p class="mt-4 border-l-4 border-stone-200 pl-4 text-base leading-7 text-stone-600 dark:border-stone-700 dark:text-stone-300">
          写代码，做系统，也记录一路上的技术判断。
        </p>
      </div>
    </section>

    <section class="site-shell py-12">
      <div class="grid gap-8 md:grid-cols-[0.85fr_1.15fr] md:items-start">
        <div>
          <p class="text-sm font-medium text-stone-500 dark:text-stone-400">Profile</p>
          <h2 class="mt-3 font-serif text-2xl font-bold leading-tight text-stone-950 dark:text-stone-50">
            全栈开发者，偏爱清晰、稳定的工程实践。
          </h2>
        </div>
        <div class="space-y-5 text-base leading-7 text-stone-700 dark:text-stone-300">
          <p>
            你好！我是 <strong class="text-stone-950 dark:text-stone-50">liuzhne</strong>，一名热爱编程的全栈开发者。我在 Web 开发领域有多年的经验，专注于构建高性能、用户友好的应用程序。
          </p>
          <p>
            我的技术栈涵盖前端、后端与 DevOps，包括 Vue.js、JavaScript、Java、Redis、Go、PostgreSQL、MongoDB、Docker、Kubernetes、CI/CD 和 Linux 等。我对新技术保持好奇心，也重视把技术沉淀为稳定、可维护的工程实践。
          </p>
          <p>
            创建这个博客的目的是记录我的学习历程，分享技术心得，同时也希望能够帮助到其他开发者。
          </p>
        </div>
      </div>
    </section>

    <section class="border-y border-stone-200 bg-stone-100/60 dark:border-stone-800 dark:bg-stone-900/30">
      <div class="site-shell py-12">
        <div class="mb-8">
          <p class="text-sm font-medium text-stone-500 dark:text-stone-400">Stack</p>
          <h2 class="mt-3 font-serif text-2xl font-bold text-stone-950 dark:text-stone-50">技术栈</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-2">
          {skills.map((category) => (
            <section class="rounded-lg border border-stone-200 bg-white p-5 dark:border-stone-800 dark:bg-stone-950">
              <h3 class="font-serif text-xl font-bold text-stone-950 dark:text-stone-50">{category.name}</h3>
              <div class="mt-6 flex flex-wrap gap-2">
                {category.items.map((skill) => (
                  <span class="rounded-lg border border-stone-200 bg-stone-50 px-3 py-1.5 text-sm text-stone-600 dark:border-stone-800 dark:bg-stone-900 dark:text-stone-300">
                    {skill}
                  </span>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section class="site-shell py-12">
      <div>
        <div class="mb-8">
          <p class="text-sm font-medium text-stone-500 dark:text-stone-400">Experience</p>
          <h2 class="mt-3 font-serif text-2xl font-bold text-stone-950 dark:text-stone-50">工作经历</h2>
        </div>
        <div class="divide-y divide-stone-200 rounded-lg border border-stone-200 bg-white px-5 dark:divide-stone-800 dark:border-stone-800 dark:bg-stone-950">
          {experiences.map((exp) => (
            <section class="grid gap-4 py-8 md:grid-cols-[160px_1fr]">
              <time class="text-sm font-medium text-stone-500 dark:text-stone-400">{exp.period}</time>
              <div>
                <h3 class="font-serif text-xl font-bold text-stone-950 dark:text-stone-50">{exp.title}</h3>
                <p class="mt-1 text-stone-500 dark:text-stone-400">{exp.company}</p>
                <p class="mt-4 text-base leading-7 text-stone-600 dark:text-stone-300">{exp.description}</p>
              </div>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section class="site-shell pb-16">
      <div class="rounded-lg border border-stone-200 bg-white p-6 dark:border-stone-800 dark:bg-stone-950">
        <h2 class="font-serif text-2xl font-bold text-stone-950 dark:text-stone-50">一起交流技术想法。</h2>
        <p class="mt-4 max-w-xl text-base leading-7 text-stone-600 dark:text-stone-300">
          如果你有任何问题、建议，或者只是想聊聊技术与工程实践，欢迎联系我。
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="https://github.com/liuzhne"
            target="_blank"
            rel="noopener noreferrer"
            class="site-button"
          >
            GitHub
          </a>
          <a
            href="mailto:1044307322@qq.com"
            class="site-button-primary"
          >
            Email
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
