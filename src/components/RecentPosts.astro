---
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', ({ data }) => {
  return data.draft !== true;
});

const recentPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

{recentPosts.length > 0 && (
  <section class="py-14 md:py-16">
    <div class="site-shell">
      <div class="mb-10 flex items-end justify-between gap-6">
        <div>
          <p class="mb-3 text-sm font-medium text-stone-500 dark:text-stone-400">
            Notes
          </p>
          <h2 class="font-serif text-2xl font-bold tracking-normal text-stone-950 dark:text-stone-50">
          最新文章
        </h2>
        </div>
        <a
          href="/blog/"
          class="flex items-center gap-1 text-sm font-medium text-stone-600 transition-colors hover:text-stone-950 dark:text-stone-400 dark:hover:text-stone-50"
        >
          查看全部
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="grid gap-4">
        {recentPosts.map((post, index) => {
          const formattedDate = post.data.pubDate.toLocaleDateString('zh-CN', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          });
          return (
            <article class="soft-card p-5">
              <a href={`/blog/posts/${post.id}/`} class="block">
                <div class="muted-meta mb-4 flex flex-wrap items-center gap-3">
                  <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
                  {post.data.tags.length > 0 && (
                    <>
                      <span class="text-stone-300 dark:text-stone-600">·</span>
                      <div class="flex flex-wrap gap-2">
                        {post.data.tags.slice(0, 3).map((tag) => (
                          <span class="text-stone-500 dark:text-stone-400">#{tag}</span>
                        ))}
                      </div>
                    </>
                  )}
                </div>
                <h3 class="mb-3 font-serif text-xl font-bold leading-snug tracking-normal text-stone-950 transition-colors hover:text-stone-600 dark:text-stone-50 dark:hover:text-stone-300">
                  {post.data.title}
                </h3>
                <p class="text-base leading-7 text-stone-600 dark:text-stone-400">
                  {post.data.description}
                </p>
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}
