---
import animeCatAvatar from '../assets/avatar-anime-cat.png';

const skills = [
  'AI Engineering',
  'Java',
  'Cloud Native',
  'Kubernetes',
  'LLM Workflow',
  'Knowledge Systems',
];
---

<section class="border-b border-stone-200 dark:border-stone-800">
  <div class="site-shell py-14 md:py-20">
    <!-- Avatar and identity -->
    <div class="mb-7 flex items-center gap-4">
      <img
        src={animeCatAvatar.src}
        width={128}
        height={128}
        alt="动漫猫猫科技博主头像"
        class="h-20 w-20 rounded-lg object-cover ring-1 ring-stone-200 dark:ring-stone-800"
      />
      <div>
        <h1 class="font-serif text-4xl font-bold leading-tight tracking-normal text-stone-950 dark:text-stone-50 md:text-5xl">
          liuzhne
        </h1>
        <p class="mt-2 text-sm font-medium text-stone-500 dark:text-stone-400">
          AI Engineering / Research Notes
        </p>
      </div>
    </div>

    <p class="mb-5 border-l-4 border-stone-200 pl-4 text-lg leading-8 text-stone-700 dark:border-stone-700 dark:text-stone-300">
      构建面向长期使用的 AI 工程系统，并记录 Java、云原生与研究工程实践。
    </p>

    <!-- Skills -->
    <div class="mb-9 flex flex-wrap gap-2">
      {skills.map((skill) => (
        <span class="rounded-lg border border-stone-200 bg-white px-3 py-1.5 text-sm text-stone-600 dark:border-stone-800 dark:bg-stone-950 dark:text-stone-300">
          {skill}
        </span>
      ))}
    </div>
  </div>
</section>
